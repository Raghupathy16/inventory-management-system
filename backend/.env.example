# Copy this file to `.env` and fill in real values.
# .env is git-ignored — never commit real secrets.

APP_NAME=Inventory & Procurement Management System
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# When running via Docker Compose, DB_HOST must be the service name "db",
# not "localhost" — containers reach each other by service name.
DB_HOST=db
DB_PORT=3306
DB_NAME=inventory_db
DB_USER=inventory_user
DB_PASSWORD=Raghu%4023

# --- Security ---
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60
